<Window
    x:Class="BMI.WPF.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BMI.WPF.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Canadian Health Guideline - BMI"
    Width="600"
    Height="490"
    mc:Ignorable="d">
    <Grid HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <GroupBox
            Grid.Row="0"
            Grid.Column="0"
            Margin="5"
            HorizontalAlignment="Stretch"
            BorderBrush="LightGray"
            BorderThickness="2"
            FontWeight="Bold"
            Header="Patient BMI Listing">
            <StackPanel>
                <Label Margin="5,5,0,0" Content="Name" />
                <ComboBox
                    x:Name="cbxPatients"
                    Margin="10,5,10,5"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="cbxPatients_SelectionChanged" />
                <Label
                    x:Name="lblRWeight"
                    Margin="5,5,5,5"
                    Content="Patient Weight:"
                    FontWeight="Bold" />
                <Label
                    x:Name="lblRHeight"
                    Margin="5,5,5,5"
                    Content="Patient Height:"
                    FontWeight="Bold" />

            </StackPanel>
        </GroupBox>

        <GroupBox
            Grid.Row="0"
            Grid.Column="1"
            Margin="5,5,5,5"
            BorderBrush="LightGray"
            BorderThickness="2"
            FontWeight="Bold"
            Header="New Patient BMI">
            <StackPanel>
                <Label
                    Margin="5,5,5,0"
                    Content="Name"
                    FontWeight="Bold" />
                <TextBox
                    x:Name="txtPName"
                    Margin="5,0,5,5"
                    VerticalAlignment="Center"
                    Background="LightGray"
                    FontWeight="Normal" />
                <Grid Margin="5,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Content="Weight"
                        FontWeight="Bold" />
                    <TextBox
                        x:Name="txtPWeight"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5,5,5,5"
                        VerticalContentAlignment="Center"
                        Background="LightGray"
                        FontWeight="Normal" />
                    <Label
                        Grid.Row="0"
                        Grid.Column="2"
                        Content="Height"
                        FontWeight="Bold" />
                    <TextBox
                        x:Name="txtPHeight"
                        Grid.Row="0"
                        Grid.Column="3"
                        Margin="5,5,5,5"
                        VerticalContentAlignment="Center"
                        Background="LightGray"
                        FontWeight="Normal" />
                </Grid>

                <Button
                    x:Name="btnAddPatient"
                    Click="btnAddPatient_Click"
                    Content="ADD PATIENT"
                    Style="{StaticResource StyleButtons}" />
                <Button
                    x:Name="btnCancel"
                    Margin="5,5,5,5"
                    Click="btnCancel_Click"
                    Content="CLEAR"
                    Style="{StaticResource StyleButtons}" />
            </StackPanel>
        </GroupBox>

        <Border
            Grid.Row="1"
            Grid.Column="1"
            Margin="5,15,9,9"
            BorderBrush="Orange"
            BorderThickness="2"
            CornerRadius="5">
            <Image Source="/Assets/body-mass-index.jpg" Stretch="Uniform" />

        </Border>

        <GroupBox
            Grid.Row="1"
            Grid.Column="0"
            Margin="5"
            HorizontalAlignment="Stretch"
            BorderBrush="LightGray"
            BorderThickness="2"
            FontWeight="Bold"
            Header="Patient BMI Info">
            <StackPanel Grid.Row="1" Grid.Column="0">
                <Label Content="Patient Weight" FontWeight="Bold" />
                <TextBox
                    x:Name="txtWeight"
                    Margin="5,5"
                    VerticalContentAlignment="Center"
                    Background="LightGray"
                    Text="" />
                <Label Content="Patient Height" FontWeight="Bold" />
                <TextBox
                    x:Name="txtHeight"
                    Margin="5,5"
                    VerticalContentAlignment="Center"
                    Background="LightGray"
                    Text="" />
                <Button
                    x:Name="btnUpdate"
                    Margin="5,5,5,5"
                    Click="btnUpdate_Click"
                    Content="UPDATE BMI"
                    FontWeight="Bold"
                    Style="{StaticResource StyleButtons}" />
                <Button
                    x:Name="btnDelete"
                    Margin="5"
                    Click="btnDelete_Click"
                    Content="DELETE BMI"
                    FontWeight="Bold"
                    Style="{StaticResource StyleButtons}" />
                <TextBlock
                    x:Name="txtblkReport"
                    Margin="5"
                    FontWeight="Normal"
                    Text="BMI result of 18.7 category is Normal weight!"
                    TextWrapping="WrapWithOverflow" />

            </StackPanel>
        </GroupBox>

    </Grid>

</Window>
